# 이 파일을 .env로 복사합니다. 실제 키/ID는 직접 입력하며 .env는 커밋하지 않습니다.
DATABASE_PATH=runtime/team.sqlite3
LLM_MODE=codex
# 같은 OS 사용자로 codex login 후 사용합니다. API 키는 필요하지 않습니다.
# 검토한 Codex CLI 버전: 0.153.0. 오프라인 실행은 LLM_MODE=mock.
CODEX_BINARY=codex
# 생략하면 Codex 기본 모델 사용. 계정에서 사용 가능한 모델 ID만 지정합니다.
# CODEX_MODEL=
CODEX_TIMEOUT_SECONDS=120
# 이전 Groq 모드는 명시적으로 LLM_MODE=groq일 때만 동작합니다.
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_CALLS_PER_MINUTE=20
LLM_MAX_OUTPUT_TOKENS=4000
# LLM_TIMEOUT_SECONDS / LLM_MAX_OUTPUT_TOKENS는 Groq 전용입니다.
MEETING_MAX_TURNS=5

# Discord Developer Portal의 Bot token. OAuth client secret과 다릅니다.
# DISCORD_BOT_TOKEN=
# 개발 서버 ID를 설정하면 해당 서버에 slash command를 빠르게 등록합니다.
# DISCORD_GUILD_ID=
# 실제 관리자 Discord 사용자 ID를 쉼표로 입력합니다. 미설정 시 관리자 작업 금지.
ADMIN_USER_IDS=

# 공개 저장소는 token 없이 조회 가능합니다. 기본값은 외부 연결 비활성입니다.
GITHUB_ENABLED=false
# GITHUB_TOKEN=

# 네 data source는 사용자가 생성하고 integration에 연결해야 합니다.
NOTION_VERSION=2026-03-11
# NOTION_TOKEN=
# NOTION_PROJECTS_DATA_SOURCE_ID=
# NOTION_TASKS_DATA_SOURCE_ID=
# NOTION_MEETINGS_DATA_SOURCE_ID=
# NOTION_REPORTS_DATA_SOURCE_ID=

# 미지정 시 자동 보고 없음. 새 프로젝트에 적용되는 기본 시각 (Asia/Seoul).
# 기존 프로젝트는 /report_schedule 또는 CLI schedule로 변경합니다.
# DAILY_REPORT_TIME=09:00
